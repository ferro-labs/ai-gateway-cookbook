# --- Recipe → gateway (always needed) ---
# Inside `docker compose`, the recipe reaches the gateway by service name.
FERRO_BASE_URL=http://gateway:8080
# Gateway image tag. Defaults to latest; pin a release for reproducibility.
# GATEWAY_VERSION=1.4.1
# The gateway's master key, presented by the recipe as its API key.
MASTER_KEY=fgw_local_dev_change_me

# --- Provider keys: ONLY needed when this recipe starts its OWN gateway via
#     `docker compose up`. They are injected into the gateway container, never
#     the recipe container. If you point FERRO_BASE_URL at an existing gateway,
#     leave these blank — that gateway already holds them. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

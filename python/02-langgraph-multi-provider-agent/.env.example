# --- Recipe → gateway (always needed) ---
# Inside docker compose, the recipe reaches the gateway by service name.
FERRO_BASE_URL=http://gateway:8080
# The gateway's master key, presented by the recipe as its API key.
MASTER_KEY=fgw_local_dev_change_me

# --- Provider keys: needed when `docker compose up` starts the bundled gateway.
#     Injected into the gateway container, never the recipe container.
#     Point FERRO_BASE_URL at an existing gateway instead? Leave these blank. ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Override the default agent task (optional).
# AGENT_REQUEST=Build a CLI that fetches the current UTC time and prints it as ISO-8601.
